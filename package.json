{
  "name": "checkclimate-africa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "emdash": {
    "label": "Check Climate Africa",
    "seed": "seed/seed.json"
  },
  "scripts": {
    "predev": "node scripts/build-tokens.mjs",
    "dev": "node scripts/with-env.mjs astro dev",
    "prebuild": "node scripts/build-tokens.mjs",
    "build": "astro build",
    "deploy:preview": "EMDASH_SITE_URL=https://checkclimate.security-focus.workers.dev pnpm build && wrangler deploy",
    "deploy:production": "EMDASH_SITE_URL=https://checkclimate.africa pnpm build && wrangler deploy",
    "preview": "node scripts/with-env.mjs astro preview",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:generate": "node scripts/seed/generate.mjs",
    "seed": "node scripts/seed/generate.mjs && tsx scripts/seed-db.ts",
    "doctor": "emdash doctor",
    "types": "emdash types",
    "post-import": "tsx scripts/post-import.ts",
    "unwrap-wayback": "tsx scripts/unwrap-wayback.ts",
    "verify-migration": "tsx scripts/verify-migration.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@astrojs/react": "^7.0.0",
    "@cloudflare/kumo": "2.15.0",
    "@emdash-cms/cloudflare": "^1.5.0",
    "@fontsource/red-hat-display": "^5.3.0",
    "astro": "^7.3.2",
    "emdash": "^1.5.0",
    "kysely": "^0.29.9",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261118.1",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "lightningcss": "^1.33.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.164.0"
  }
}