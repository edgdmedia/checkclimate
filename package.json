{
  "name": "checkclimate-africa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "emdash": {
    "label": "Check Climate Africa",
    "seed": "seed/seed.json"
  },
  "scripts": {
    "predev": "node scripts/build-tokens.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/build-tokens.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:generate": "node scripts/seed/generate.mjs",
    "seed": "node scripts/seed/generate.mjs && emdash seed seed/seed.json --database ./data/checkclimate.db && node scripts/seed/fix-dates.mjs",
    "types": "emdash types",
    "post-import": "tsx scripts/post-import.ts",
    "verify-migration": "tsx scripts/verify-migration.ts"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.5",
    "@astrojs/react": "^7.0.0",
    "@aws-sdk/client-s3": "^3.879.0",
    "@aws-sdk/s3-request-presigner": "^3.879.0",
    "@fontsource/red-hat-display": "^5.3.0",
    "@libsql/client": "^0.8.1",
    "astro": "^7.3.2",
    "emdash": "^1.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.10.0",
    "lightningcss": "^1.33.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}