# Runtime configuration for the Check Climate Africa Node process.
#
# Install as /etc/checkclimate.env:
#     sudo install -o root -g root -m 600 deploy/checkclimate.env.example /etc/checkclimate.env
#     sudo nano /etc/checkclimate.env
#
# systemd reads this file as root and passes the variables to the process.
# Format: KEY=value, one per line, no `export`, no shell quoting. A value
# with a `#` or spaces is fine — systemd does not parse comments inside a
# value.

# --- The public origin -----------------------------------------------------
# Must also be set at BUILD time (see /etc/checkclimate.build.env). For
# staging use https://vps.checkclimate.africa in both files.
EMDASH_SITE_URL=https://checkclimate.africa

# --- Paths ------------------------------------------------------------------
# The database lives on local disk, not on NFS: SQLite runs in WAL mode and
# WAL needs shared memory.
DATABASE_PATH=/home/checkclimate/data/emdash.db
# Astro's session store (the admin's login). Outside the app directory, so a
# deploy does not log the newsroom out.
SESSION_DIR=/home/checkclimate/data/sessions

# --- Where the site listens -------------------------------------------------
# Must match proxy_pass in deploy/nginx-proxy.conf.
HOST=127.0.0.1
PORT=4331

# --- Secrets ----------------------------------------------------------------
# THE SAME VALUE THE WORKER USES TODAY (it is in the repo's .env). The Resend
# key and Turnstile secret are stored encrypted with it inside the database;
# a different key makes every stored setting unreadable. Do not generate a
# new one.
EMDASH_ENCRYPTION_KEY=

# Resend, for invites, magic links, password recovery and claim mail. The
# From domain (notify.checkclimate.africa) is verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Check Climate Africa <newsroom@notify.checkclimate.africa>
# Where submitted claims are sent.
CLAIMS_INBOX=

# Turnstile (claim form and comments). Without the secret, the server-side
# check is skipped.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare: the zone and a token with Zone > Cache Purge. The token is
# what lets a publish drop the affected pages from the edge cache.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
# Set to 0 to switch the purge plugin off (the site still works, the edge
# cache is just never purged).
CLOUDFLARE_PURGE_ENABLED=1

# --- Media (Cloudflare R2 over its S3 API) ----------------------------------
# Media stays in the existing checkclimate-media bucket; the URLs do not
# change. Token: R2 > Manage R2 API Tokens > Create API token > Object Read &
# Write, scoped to checkclimate-media ONLY. Backups use a different token
# (rclone, Task 17 Step 7), never this one.
S3_ENDPOINT=https://9c8aaa232a52d145430685011e9fff9c.r2.cloudflarestorage.com
S3_BUCKET=checkclimate-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
