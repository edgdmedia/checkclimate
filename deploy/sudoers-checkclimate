# A narrow sudo rule for the `checkclimate` user: it may restart the site's
# service, and nothing else.
#
# Install as /etc/sudoers.d/checkclimate (mode 440, root-owned):
#     sudo install -o root -g root -m 440 deploy/sudoers-checkclimate /etc/sudoers.d/checkclimate
#     sudo visudo -c
#
# The rule names the exact command, so `sudo systemctl restart checkclimate`
# works and `sudo systemctl restart nginx` (or anything else) does not.
# `sudo -l` lists what the user may do.

checkclimate ALL=(root) NOPASSWD: /usr/bin/systemctl restart checkclimate.service
checkclimate ALL=(root) NOPASSWD: /usr/bin/systemctl status checkclimate.service
