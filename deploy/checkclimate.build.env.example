# Build-time configuration for the Check Climate Africa site.
#
# Install as /etc/checkclimate.build.env:
#     sudo install -o root -g root -m 644 deploy/checkclimate.build.env.example /etc/checkclimate.build.env
#
# These are the variables the BUILD needs. They are not secrets, so the file
# can be world-readable; the secrets live in /etc/checkclimate.env, which
# only root can read. The deploy script (scripts/deploy-vps.sh) sources this
# file before `pnpm build:vps`.
#
# Why the build needs them: astro.config.mjs reads DATABASE_PATH and
# SESSION_DIR at build time and bakes them into the bundle (setting them only
# at runtime has no effect), and refuses a localhost EMDASH_SITE_URL.

# The public origin. For a staging build use https://vps.checkclimate.africa
# and nothing else changes.
EMDASH_SITE_URL=https://checkclimate.africa

# The SQLite file and the session store.
DATABASE_PATH=/home/checkclimate/data/emdash.db
SESSION_DIR=/home/checkclimate/data/sessions

# Media: the S3 adapter (R2 over its S3 API) is chosen when S3_BUCKET is
# set. The credentials are runtime secrets and are NOT here.
S3_BUCKET=checkclimate-media
S3_ENDPOINT=https://9c8aaa232a52d145430685011e9fff9c.r2.cloudflarestorage.com
S3_REGION=auto
