---
/**
 * Search results. Paginated with ?page=N and never cached: the page depends on
 * the query string, and src/middleware.ts only lets private paths through. The
 * matching is src/utils/search.ts — the full-text index when it exists, a scan
 * when it does not.
 */
import Archive from "../../components/Archive.astro";
import { pageFromParam, searchView } from "../../utils/archive";

const query = Astro.url.searchParams.get("q")?.trim() ?? "";
const view = await searchView(query, pageFromParam(Astro.url.searchParams.get("page")));
---

<Archive {...view} searchTerm={query} />
