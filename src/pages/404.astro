---
/**
 * Branded 404. Reached two ways: Astro's own not-found handler, and a rewrite
 * from a route that decided the slug does not exist. The rewrite arrives with
 * a 200, so the page owns the status.
 */
import Base from "../layouts/Base.astro";

if (Astro.response.status === 200) Astro.response.status = 404;
---

<Base title="Page not found" robots="noindex">
	<div class="wrap notfound">
		<span class="notfound__eyebrow">Error 404</span>
		<h1 class="notfound__title">We couldn't find that page</h1>
		<p class="notfound__lede">
			The link you followed may be broken, or the page may have been moved.
			Try the search, or head back to the homepage.
		</p>
		<div class="notfound__actions">
			<a href="/" class="btn btn--amber">Back to the homepage</a>
			<a href="/search/" class="btn btn--ghost">Search the site</a>
		</div>
	</div>
</Base>

<style>
	.notfound {
		padding-block: 80px 120px;
		max-width: 720px;
		text-align: center;
	}

	.notfound__eyebrow {
		font-size: 13px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-weight: 900;
		color: var(--brand-amber);
	}

	.notfound__title {
		margin: 12px 0 20px;
		font-size: 46px;
		line-height: 52px;
		font-weight: 900;
		color: var(--ink);
	}

	.notfound__lede {
		margin: 0 auto 32px;
		font-size: 19px;
		line-height: 31px;
		color: var(--ink-body);
		max-width: 560px;
	}

	.notfound__actions {
		display: flex;
		gap: 12px;
		justify-content: center;
		flex-wrap: wrap;
	}

	@media (max-width: 600px) {
		.notfound__title {
			font-size: 32px;
			line-height: 38px;
		}
	}
</style>