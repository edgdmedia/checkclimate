---
/**
 * The public face of /admin/: a branded door, not the CMS itself. EmDash's
 * admin lives at /_emdash/admin and needs a passkey or magic link; this page
 * is what old WordPress bookmarks and /login land on.
 *
 * Noindex in both the meta tag and the header, so crawlers see it whichever
 * way they look.
 */
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
/** Small WebP copy in public/brand (displayed at half this size). */
const logoDark = { src: "/brand/logo-dark.webp", width: 336, height: 112 };

Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
const adminUrl = "/_emdash/admin";
---

<Base title="Newsroom sign in" robots="noindex, nofollow" bare>
	<section class="admin-door">
		<div class="wrap admin-door__inner">
			<a href="/" aria-label="Check Climate Africa home">
				<img
					src={logoDark.src}
					width={logoDark.width}
					height={logoDark.height}
					alt="Check Climate Africa"
					class="admin-door__logo"
				/>
			</a>
			<span class="admin-door__eyebrow">For the newsroom</span>
			<h1 class="admin-door__title">Sign in to the desk</h1>
			<p class="admin-door__lede">
				Writers and editors sign in with a passkey, or a magic link sent to
				their email. Readers never need an account.
			</p>
			<div class="admin-door__actions">
				<a href={adminUrl} class="admin-door__cta">
					<Icon name="arrow-right" size={18} />
					Open the admin
				</a>
				<a href="/" class="admin-door__link">Back to the site</a>
			</div>
			<p class="admin-door__note">
				No account yet? Ask an editor to invite you — access is by
				invitation only.
			</p>
		</div>
	</section>
</Base>

<style>
	.admin-door {
		background: var(--brand-forest);
		color: var(--on-brand);
		/* Full-screen canvas: the page has no site header or footer. */
		min-height: 100vh;
		min-height: 100dvh;
		display: grid;
		align-items: center;
		padding-block: 48px;
	}

	.admin-door__inner {
		max-width: 720px;
	}

	.admin-door__logo {
		display: block;
		width: auto;
		height: 44px;
		max-width: 100%;
		margin-bottom: 32px;
	}

	.admin-door__eyebrow {
		display: block;
		font-size: 13px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-weight: 900;
		color: var(--brand-amber);
	}

	.admin-door__title {
		color: var(--on-brand);
		margin: 12px 0;
		font-size: 44px;
		line-height: 50px;
		font-weight: 900;
		letter-spacing: -0.01em;
	}

	.admin-door__lede {
		margin: 0;
		font-size: 17px;
		line-height: 27px;
		color: var(--on-image);
		max-width: 560px;
	}

	.admin-door__actions {
		display: flex;
		align-items: center;
		gap: 20px;
		flex-wrap: wrap;
		margin-top: 32px;
	}

	.admin-door__cta {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		height: 52px;
		padding-inline: 26px;
		border-radius: var(--radius-pill);
		background: var(--brand-amber);
		color: #000000;
		font-size: 17px;
		font-weight: 700;
		text-decoration: none;
	}

	.admin-door__link {
		color: var(--on-brand);
		font-weight: 700;
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.admin-door__note {
		margin: 28px 0 0;
		font-size: 14px;
		line-height: 22px;
		color: var(--on-image);
	}

	@media (max-width: 600px) {
		.admin-door {
			padding-block: 44px 52px;
		}

		.admin-door__title {
			font-size: 32px;
			line-height: 38px;
		}
	}
</style>
