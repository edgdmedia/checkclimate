---
/**
 * Submit a claim. The same route renders the form and handles the POST:
 * validate with zod, verify Turnstile server side, put the screenshot in R2,
 * save a claims entry, email the desk. Success redirects (POST → 303 → GET)
 * so a refresh cannot submit twice.
 */
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Icon from "../../components/Icon.astro";
import StoryCard from "../../components/StoryCard.astro";
import {
	PLATFORM_OPTIONS,
	submitClaim,
	type ClaimFormValues,
} from "../../utils/claims";
import { turnstileSiteKey } from "../../utils/turnstile";
import { siteConfig } from "../../utils/site";
import type { Post } from "../../utils/content";
import { isFactCheck } from "../../utils/content";

const { entries: factChecks } = await getEmDashCollection("posts", {
	where: { kicker: "fact_check" },
	orderBy: { published_at: "desc" },
	limit: 3,
});
const recent = (factChecks as Post[]).filter(isFactCheck).slice(0, 3);
const siteKey = turnstileSiteKey();
const { contactEmail } = await siteConfig();

/** Field copy, in the order the design shows it. */
const COUNTRIES = [
	"Nigeria",
	"Ghana",
	"Kenya",
	"South Africa",
	"Ethiopia",
	"Sierra Leone",
	"Another African country",
	"Africa as a whole",
	"Outside Africa",
];

let banner: { tone: "error" | "ok"; message: string } | null = null;
let errors: Record<string, string[]> = {};
let values: ClaimFormValues = {};

if (Astro.request.method === "POST") {
	const outcome = await submitClaim({
		formData: await Astro.request.formData(),
		origin: (Astro.site ?? Astro.url.origin).toString(),
		remoteIp: Astro.request.headers.get("cf-connecting-ip"),
	});

	if (outcome.ok) {
		if (outcome.notifyError) {
			console.error("[claims] saved, but the desk email failed:", outcome.notifyError);
		}
		// POST → 303 → GET, so refreshing the page cannot submit twice.
		return Astro.redirect(`${Astro.url.pathname}?status=sent`, 303);
	}

	// A rejected submission is a 400: still a page, never a cached or indexed one.
	Astro.response.status = 400;
	errors = outcome.errors ?? {};
	values = outcome.values ?? {};
	banner =
		outcome.kind === "invalid"
			? { tone: "error", message: "Some answers need another look." }
			: {
					tone: "error",
					message:
						outcome.message ??
						"We could not send that. Please try again.",
				};
}

const sent = Astro.url.searchParams.get("status") === "sent";

const valueFor = (name: keyof ClaimFormValues): string => {
	const value = values[name];
	return typeof value === "string" ? value : "";
};
const errorFor = (name: string): string | null => (errors[name] ?? [])[0] ?? null;
---

<Base title="Submit a claim" robots={sent || Object.keys(errors).length ? "noindex" : undefined}>
	<section class="sc-head">
		<div class="wrap">
			<Breadcrumb
				items={[
					{ label: "Home", href: "/" },
					{ label: "Fact Check", href: "/category/fact-check/" },
					{ label: sent ? "Thank you" : "Submit a claim" },
				]}
				onBrand
			/>
			<span class="sc-head__eyebrow">The fact-check desk</span>
			{sent ? (
				<h1 class="sc-head__title">Thank you. The desk has it.</h1>
			) : (
				<h1 class="sc-head__title">Seen a climate claim you doubt? Send it to us.</h1>
			)}
			<p class="sc-head__lede">
				{sent
					? "A reviewer reads every submission before we start checking. We will only contact you if we need something else."
					: "A WhatsApp forward, a viral video, a quote from a public figure: if it is about the climate in Africa, we want to see it."}
			</p>
			<div class="sc-steps">
				<div class="sc-step">
					<strong class="sc-step__num">1</strong>
					<span><strong>You send the claim</strong> With a link or screenshot if you have one.</span>
				</div>
				<div class="sc-step">
					<strong class="sc-step__num">2</strong>
					<span><strong>Our desk reviews it</strong> We check it against official sources, data and experts.</span>
				</div>
				<div class="sc-step">
					<strong class="sc-step__num">3</strong>
					<span><strong>We publish what we find</strong> And email you the fact check if you left an address.</span>
				</div>
			</div>
		</div>
	</section>

	<div class="wrap sc-body">
		<div>
			{sent ? (
				<div class="sc-done">
					<span class="sc-done__mark">
						<Icon name="check" size={26} />
					</span>
					<h2 class="sc-form__title">What happens next</h2>
					<ol class="sc-done__list">
						<li>A reviewer reads it and decides whether it is checkable.</li>
						<li>If we check it, we may ask you for the original post.</li>
						<li>Published fact checks appear under <a href="/category/fact-check/">Fact Check</a>.</li>
					</ol>
					<div class="sc-done__actions">
						<a href="/" class="sc-submit">Back to the homepage</a>
						<a href="/submit-a-claim/" class="more">Send another claim</a>
					</div>
				</div>
			) : (
				<form
					aria-labelledby="form-title"
					class="sc-form"
					method="post"
					action="/submit-a-claim/"
					enctype="multipart/form-data"
				>
					{banner && (
						<div class="sc-alert" role="alert" data-tone={banner.tone}>
							{banner.message}
						</div>
					)}
					{errors.form && (
						<div class="sc-alert" role="alert" data-tone="error">
							{errors.form.join(" ")}
						</div>
					)}

					<div>
						<h2 id="form-title" class="sc-form__title">The claim</h2>
						<p class="sc-form__hint">Fields marked * are required. It takes about two minutes.</p>
					</div>

					<label class="sc-label">
						<span>What does the claim say? *</span>
						<span class="sc-label__hint">
							Paste the text or describe the video or image in your own words.
						</span>
						<textarea
							name="claim"
							rows={5}
							required
							maxlength={4000}
							aria-invalid={errorFor("claim") ? "true" : undefined}
							aria-describedby={errorFor("claim") ? "err-claim" : undefined}
							placeholder="e.g. A video says this flooded road is in Lekki, Lagos"
						>{valueFor("claim")}</textarea>
						{errorFor("claim") && (
							<span id="err-claim" class="sc-error">{errorFor("claim")}</span>
						)}
					</label>

					<div class="sc-pair">
						<label class="sc-label">
							<span>Where did you see it? *</span>
							<select
								name="platform"
								required
								aria-invalid={errorFor("platform") ? "true" : undefined}
								aria-describedby={errorFor("platform") ? "err-platform" : undefined}
							>
								<option value="">Choose one</option>
								{PLATFORM_OPTIONS.map((option) => (
									<option
										value={option.label}
										selected={valueFor("platform") === option.label}
									>
										{option.label}
									</option>
								))}
							</select>
							{errorFor("platform") && (
								<span id="err-platform" class="sc-error">{errorFor("platform")}</span>
							)}
						</label>
						<label class="sc-label">
							<span>Which country is it about?</span>
							<select name="country">
								<option value="">Choose one</option>
								{COUNTRIES.map((country) => (
									<option
										value={country}
										selected={valueFor("country") === country}
									>
										{country}
									</option>
								))}
							</select>
						</label>
					</div>

					<label class="sc-label">
						<span>Link to the post</span>
						<input
							type="url"
							name="link"
							value={valueFor("link")}
							placeholder="https://"
							aria-invalid={errorFor("link") ? "true" : undefined}
							aria-describedby={errorFor("link") ? "err-link" : undefined}
						/>
						{errorFor("link") && (
							<span id="err-link" class="sc-error">{errorFor("link")}</span>
						)}
					</label>

					<label class="sc-label">
						<span>Screenshot or photo</span>
						<span class="sc-drop">
							<Icon name="upload" size={28} />
							<span>
								Drop a file here or <u>browse</u>
								<br />
								<span class="sc-drop__hint">JPG, PNG or WebP, up to 8 MB</span>
							</span>
							<input
								type="file"
								name="attachment"
								accept="image/jpeg,image/png,image/webp"
							/>
						</span>
						<span class="sc-label__hint">
							For a video, paste the link instead — we can open it from there.
						</span>
						{errorFor("attachment") && (
							<span class="sc-error">{errorFor("attachment")}</span>
						)}
					</label>

					<hr />
					<div>
						<h2 class="sc-form__title">
							About you <span class="sc-form__hint">(optional)</span>
						</h2>
						<p class="sc-form__hint">Leave an email and we will tell you what we find.</p>
					</div>

					<div class="sc-pair">
						<label class="sc-label">
							<span>Your name</span>
							<input
								type="text"
								name="name"
								value={valueFor("name")}
								autocomplete="name"
							/>
						</label>
						<label class="sc-label">
							<span>Email</span>
							<input
								type="email"
								name="email"
								value={valueFor("email")}
								autocomplete="email"
								aria-invalid={errorFor("email") ? "true" : undefined}
								aria-describedby={errorFor("email") ? "err-email" : undefined}
							/>
							{errorFor("email") && (
								<span id="err-email" class="sc-error">{errorFor("email")}</span>
							)}
						</label>
					</div>

					<label class="sc-check">
						<input
							type="checkbox"
							name="consent"
							value="true"
							checked={values.consent === undefined ? true : Boolean(values.consent)}
						/>
						<span>Don't name me if this becomes a published fact check.</span>
					</label>

					{siteKey && (
						<div
							class="cf-turnstile"
							data-sitekey={siteKey}
							data-action="claim_submit"
						></div>
					)}

					{/** Honeypot: humans never see or fill this. */}
					<div class="sc-hp" aria-hidden="true">
						<label>
							Website
							<input type="text" name="website" tabindex="-1" autocomplete="off" />
						</label>
					</div>

					<div class="sc-form__foot">
						<button type="submit" class="sc-submit">
							<Icon name="check" size={18} />
							Send for checking
						</button>
						<span class="sc-form__privacy">
							We use your details only to follow up on this claim. See our{" "}
							<a href="/privacy-policy/">Privacy Policy</a>.
						</span>
					</div>
				</form>
			)}
		</div>
		<aside class="sc-side">
			<div class="panel">
				<h2 class="panel__title">What makes a good submission</h2>
				<ul>
					<li>The exact words, or a screenshot of the post.</li>
					<li>Where and when you saw it.</li>
					<li>One claim per submission.</li>
				</ul>
			</div>
			<div class="panel panel--outline">
				<h2 class="panel__label">Recent fact checks</h2>
				{recent.length > 0 ? (
					recent.map((post) => (
						<StoryCard post={post} variant="text" headingLevel={5} />
					))
				) : (
					<p class="sc-form__hint">Nothing published yet — the desk is working.</p>
				)}
			</div>
			<div class="sc-email">
				<strong>Prefer email?</strong>
				<span>
					Send it to{" "}
					<a
						href={`mailto:${contactEmail}?subject=Climate%20claim%20to%20check`}>{contactEmail}</a
					>
				</span>
			</div>
		</aside>
	</div>
	{siteKey && (
		<script is:inline async src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>
	)}
</Base>

<style>
	.sc-head {
		background: var(--brand-forest);
		color: var(--on-brand);
		padding-block: 32px 44px;
	}

	.sc-head__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin-top: 22px;
		font-size: 13px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-weight: 900;
		color: var(--brand-amber);
	}

	.sc-head__title {
		/* The global h1 colour is --ink; this sits on the green bar. */
		color: var(--on-brand);
		margin: 10px 0 12px;
		font-size: 50px;
		line-height: 56px;
		font-weight: 900;
		letter-spacing: -0.01em;
		max-width: 860px;
	}

	.sc-head__lede {
		margin: 0;
		font-size: 18px;
		line-height: 28px;
		color: var(--on-image);
		max-width: 680px;
	}

	.sc-steps {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 20px;
		margin-top: 32px;
	}

	.sc-step {
		display: flex;
		gap: 14px;
		align-items: flex-start;
		padding: 18px;
		border-radius: var(--radius);
		background: rgba(0, 0, 0, 0.18);
		font-size: 15px;
		line-height: 22px;
	}

	.sc-step strong:first-child {
		display: block;
		font-size: 16px;
	}

	.sc-step__num {
		flex: none;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		display: grid;
		place-items: center;
		background: var(--brand-amber);
		color: #000000;
		font-weight: 900;
	}

	.sc-body {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 360px;
		gap: 48px;
		padding-block: 40px 64px;
	}

	.sc-form {
		padding: 32px;
		border-radius: var(--radius-big);
		border: 1px solid var(--border);
		background: var(--surface-raised);
		display: flex;
		flex-direction: column;
		gap: 22px;
		font-size: 15px;
		line-height: 20px;
	}

	.sc-form__title {
		margin: 0 0 4px;
		font-size: 26px;
		line-height: 32px;
		font-weight: 700;
		color: var(--ink);
	}

	.sc-form__hint {
		margin: 0;
		font-size: 14px;
		color: var(--ink-muted);
		font-weight: 400;
	}

	.sc-alert {
		padding: 14px 16px;
		border-radius: var(--radius);
		font-size: 15px;
		line-height: 22px;
		font-weight: 500;
		border: 1px solid var(--border-strong);
		border-left-width: 4px;
		border-left-color: var(--danger);
		background: var(--surface-muted);
		color: var(--ink);
	}

	/* --danger is a signal colour, never a text colour: #ff0003 fails contrast
	   as small type. Errors carry a rule and bold ink instead. */
	.sc-error {
		display: flex;
		align-items: baseline;
		gap: 6px;
		color: var(--ink);
		font-size: 14px;
		line-height: 20px;
		font-weight: 700;
	}

	.sc-error::before {
		content: "";
		flex: none;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--danger);
	}

	.sc-label {
		display: flex;
		flex-direction: column;
		gap: 8px;
		font-weight: 700;
		color: var(--ink);
	}

	.sc-label__hint {
		font-weight: 400;
		font-size: 14px;
		color: var(--ink-muted);
	}

	.sc-label input,
	.sc-label textarea,
	.sc-label select {
		padding: 12px 14px;
		border-radius: var(--radius);
		border: 1px solid var(--border-strong);
		background: var(--surface-raised);
		color: var(--ink);
		font: 400 16px/24px var(--font-display);
		resize: vertical;
	}

	.sc-label input,
	.sc-label select {
		height: 48px;
	}

	.sc-label input[aria-invalid="true"],
	.sc-label textarea[aria-invalid="true"],
	.sc-label select[aria-invalid="true"] {
		border-color: var(--danger);
		border-width: 2px;
	}

	.sc-pair {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 20px;
	}

	.sc-drop {
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 18px;
		border-radius: var(--radius);
		border: 2px dashed var(--border-strong);
		background: var(--surface-muted);
		font-weight: 500;
		color: var(--ink-body);
		position: relative;
		cursor: pointer;
	}

	.sc-drop input {
		position: absolute;
		inset: 0;
		opacity: 0;
		cursor: pointer;
	}

	.sc-drop__hint {
		font-size: 13px;
		color: var(--ink-muted);
	}

	.sc-hp {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.sc-check {
		display: flex;
		align-items: flex-start;
		gap: 12px;
		font-weight: 500;
		color: var(--ink-body);
		cursor: pointer;
	}

	.sc-check input {
		width: 20px;
		height: 20px;
		margin: 0;
		accent-color: var(--brand-forest);
		flex: none;
	}

	.sc-form hr {
		height: 1px;
		background: var(--border);
		border: 0;
		margin: 0;
	}

	.sc-form__foot {
		display: flex;
		align-items: center;
		gap: 16px;
		flex-wrap: wrap;
	}

	.sc-submit {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		height: 52px;
		padding-inline: 28px;
		border: 0;
		border-radius: var(--radius-pill);
		background: var(--brand-forest);
		color: #ffffff;
		font: 700 17px var(--font-display);
		cursor: pointer;
		text-decoration: none;
	}

	.sc-form__privacy {
		font-size: 13px;
		line-height: 18px;
		color: var(--ink-muted);
		max-width: 360px;
	}

	.sc-form__privacy a {
		color: var(--link);
		text-decoration: underline;
	}

	.sc-done {
		padding: 32px;
		border-radius: var(--radius-big);
		border: 1px solid var(--border);
		background: var(--surface-raised);
	}

	.sc-done__mark {
		display: grid;
		place-items: center;
		width: 52px;
		height: 52px;
		border-radius: 50%;
		background: var(--brand-amber);
		color: #000000;
		margin-bottom: 18px;
	}

	.sc-done__list {
		margin: 14px 0 24px;
		padding-left: 22px;
		display: flex;
		flex-direction: column;
		gap: 8px;
		font-size: 16px;
		line-height: 26px;
		color: var(--ink-body);
	}

	.sc-done__actions {
		display: flex;
		align-items: center;
		gap: 18px;
		flex-wrap: wrap;
	}

	.sc-side {
		display: flex;
		flex-direction: column;
		gap: 24px;
	}

	.sc-side .panel--outline {
		background: transparent;
		border: 1px solid var(--border);
	}

	.sc-email {
		padding: 24px;
		border-radius: var(--radius);
		background: var(--brand-amber);
		color: #000000;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.sc-email strong {
		font-size: 17px;
		font-weight: 900;
	}

	.sc-email a {
		font-weight: 700;
		text-decoration: underline;
		color: inherit;
	}

	@media (max-width: 900px) {
		.sc-body,
		.sc-steps {
			grid-template-columns: minmax(0, 1fr);
		}

		.sc-head__title {
			font-size: 38px;
			line-height: 44px;
		}
	}

	@media (max-width: 600px) {
		.sc-pair {
			grid-template-columns: minmax(0, 1fr);
		}

		.sc-form,
		.sc-done {
			padding: 22px;
		}
	}
</style>
