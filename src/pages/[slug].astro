---
/**
 * Static pages: /about-us/, /contact-us/, /privacy-policy-2/, etc.
 * EmDash pages live at /{slug}/; this route matches any single-segment path
 * and rewrites to 404 when the slug is not a published page.
 */
import type { PageEntry } from "../utils/content";
import { absoluteUrl, imageUrl, pagePath } from "../utils/content";
import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import Breadcrumb from "../components/Breadcrumb.astro";

const { slug } = Astro.params;
const { entry: page } = await getEmDashEntry("pages", slug ?? "");
if (!page) return Astro.rewrite("/404");

const data = page.data as PageEntry["data"];
const typed: PageEntry = { ...page, data } as PageEntry;
const title = typeof data.title === "string" ? data.title : "Untitled";
const image = imageUrl(Astro.url.origin, data.featured_image);

// /about-us/ and /contact-us/ share the About design; other pages render
// as plain prose.
const isAbout = slug === "about-us" || slug === "contact-us";
---

<Base
	title={title}
	image={image}
	content={{ collection: "pages", id: data.id, slug: data.slug }}
>
	{isAbout ? (
		<>
			<section class="about-hero">
				<div class="wrap about-hero__inner">
					<div>
						<span class="about-hero__eyebrow">About us</span>
						<h1 class="about-hero__title">{title}</h1>
						<p class="about-hero__lede">
							Check Climate Africa is a pioneering media consultancy initiative
							focused on disseminating critical climate information to key
							stakeholders across Africa, including governments, policymakers,
							and the general public.
						</p>
					</div>
				</div>
			</section>
			<div class="wrap about-body prose">
				<PortableText value={data.content} />
			</div>
		</>
	) : (
		<div class="wrap page-body">
			<Breadcrumb items={[{ label: "Home", href: "/" }, { label: title }]} />
			<h1 class="page-body__title">{title}</h1>
			<div class="prose">
				<PortableText value={data.content} />
			</div>
		</div>
	)}
</Base>

<style>
	.about-hero {
		background: var(--brand-forest);
		color: var(--on-brand);
		padding-block: 56px 64px;
	}

	.about-hero__inner {
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
		gap: 48px;
		align-items: center;
	}

	.about-hero__eyebrow {
		font-size: 13px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-weight: 900;
		color: var(--brand-amber);
	}

	.about-hero__title {
		margin: 12px 0 20px;
		font-size: 54px;
		line-height: 60px;
		font-weight: 900;
		letter-spacing: -0.01em;
	}

	.about-hero__lede {
		margin: 0;
		font-size: 19px;
		line-height: 31px;
		color: var(--on-image);
		max-width: 640px;
	}

	.about-body {
		padding-block: 64px 24px;
		max-width: 720px;
	}

	.page-body {
		padding-block: 36px 64px;
	}

	.page-body__title {
		margin: 20px 0 28px;
		font-size: 40px;
		line-height: 46px;
		font-weight: 900;
		color: var(--ink);
	}

	@media (max-width: 900px) {
		.about-hero__inner {
			grid-template-columns: minmax(0, 1fr);
		}

		.about-hero__title {
			font-size: 40px;
			line-height: 46px;
		}
	}
</style>