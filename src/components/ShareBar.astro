---
/**
 * Share bar: Facebook, X, LinkedIn, WhatsApp and copy-to-clipboard. The copy
 * control is a real <button> that writes the URL and announces "Copied!".
 */
import Icon from "./Icon.astro";

interface Props {
	url: string;
	title: string;
	/** On the green fact-check band: white label and outlined copy button. */
	onBrand?: boolean;
}

const { url, title, onBrand = false } = Astro.props;

const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
---

<div class:list={["share", onBrand && "share--brand"]}>
	<span class="share__label">Share</span>
	<a
		class="share__btn share__btn--facebook"
		href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
		target="_blank"
		rel="noopener noreferrer"
		aria-label="Share on Facebook"
	>
		<Icon name="facebook" size={18} />
	</a>
	<a
		class="share__btn share__btn--x"
		href={`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`}
		target="_blank"
		rel="noopener noreferrer"
		aria-label="Share on X"
	>
		<Icon name="x" size={16} />
	</a>
	<a
		class="share__btn share__btn--linkedin"
		href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`}
		target="_blank"
		rel="noopener noreferrer"
		aria-label="Share on LinkedIn"
	>
		<Icon name="linkedin" size={16} />
	</a>
	<a
		class="share__btn share__btn--whatsapp"
		href={`https://wa.me/?text=${encodedTitle}%20${encodedUrl}`}
		target="_blank"
		rel="noopener noreferrer"
		aria-label="Share on WhatsApp"
	>
		<Icon name="whatsapp" size={16} />
	</a>
	<button
		type="button"
		class="share__btn share__btn--copy"
		data-copy={url}
		aria-label="Copy link to this story"
	>
		<Icon name="link" size={18} />
	</button>
	<span class="share__status" data-copy-status role="status" hidden>Copied!</span>
</div>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>("[data-copy]");
	for (const button of buttons) {
		button.addEventListener("click", async () => {
			const url = button.dataset.copy;
			if (!url) return;
			const status = button.parentElement?.querySelector<HTMLElement>(
				"[data-copy-status]",
			);
			try {
				await navigator.clipboard.writeText(url);
			} catch {
				// Clipboard can be blocked in private windows; nothing to show.
			}
			if (status) {
				status.hidden = false;
				window.setTimeout(() => {
					status.hidden = true;
				}, 1600);
			}
		});
	}
</script>

<style>
	.share {
		display: flex;
		align-items: center;
		gap: 8px;
		flex-wrap: wrap;
	}

	.share__label {
		font-size: 14px;
		font-weight: 700;
		color: var(--ink);
		margin-inline-end: 4px;
	}

	.share--brand .share__label {
		color: var(--on-brand);
	}

	.share__btn {
		width: 40px;
		height: 40px;
		border-radius: var(--radius-pill);
		display: grid;
		place-items: center;
		border: 0;
		color: #ffffff;
		cursor: pointer;
		text-decoration: none;
	}

	.share__btn--facebook {
		background: var(--social-facebook);
	}

	.share__btn--x {
		background: #000000;
	}

	.share__btn--linkedin {
		background: var(--social-linkedin);
	}

	.share__btn--whatsapp {
		background: var(--brand-forest);
	}

	.share--brand .share__btn--whatsapp {
		background: var(--brand-amber);
		color: #000000;
	}

	.share__btn--copy {
		border: 1px solid var(--border-strong);
		background: var(--surface-raised);
		color: var(--ink);
	}

	.share--brand .share__btn--copy {
		border-color: rgba(255, 255, 255, 0.5);
		background: transparent;
		color: #ffffff;
	}

	.share__status {
		font-size: 13px;
		font-weight: 500;
		color: var(--ink-muted);
	}

	.share--brand .share__status {
		color: var(--brand-amber);
	}
</style>
