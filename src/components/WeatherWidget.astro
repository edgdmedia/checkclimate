---
/**
 * Weather line in the top bar.
 *
 * The readings come from Open-Meteo in the browser, so the page itself stays
 * cacheable at the edge and the Worker spends no CPU on it. Without
 * JavaScript — or if the request fails — the line stays hidden rather than
 * showing invented numbers.
 *
 * The place is a site setting (plugins/site-settings), so the desk can move
 * the needle without a deploy.
 */
import Icon from "./Icon.astro";
import { siteConfig } from "../utils/site";

const { weather } = await siteConfig();
---

<span
	class="topbar__weather weather"
	data-weather
	data-city={weather.city}
	data-country={weather.country}
	data-lat={weather.latitude}
	data-lon={weather.longitude}
	hidden
>
	<Icon name="sun" size={16} class="weather__icon" />
	<strong class="weather__temp" data-weather-temp></strong>
	<span class="weather__place" data-weather-place></span>
	<span class="weather__detail" data-weather-detail></span>
</span>

<script>
	/**
	 * One fetch per half hour per tab: sessionStorage keeps the reading across
	 * page views, and Open-Meteo needs no key.
	 */
	const CACHE_KEY = "cca-weather";
	const CACHE_MS = 30 * 60 * 1000;

	interface Reading {
		temp: number;
		humidity: number;
		sunset: string | null;
		city: string;
		country: string;
		at: number;
	}

	function formatSunset(iso: string | null): string | null {
		if (!iso) return null;
		const date = new Date(iso);
		if (Number.isNaN(date.getTime())) return null;
		return date.toLocaleTimeString("en-GB", {
			hour: "numeric",
			minute: "2-digit",
			hour12: true,
		});
	}

	function paint(target: HTMLElement, reading: Reading): void {
		const temp = target.querySelector<HTMLElement>("[data-weather-temp]");
		const place = target.querySelector<HTMLElement>("[data-weather-place]");
		const detail = target.querySelector<HTMLElement>("[data-weather-detail]");
		if (!temp || !place || !detail) return;

		temp.textContent = `${Math.round(reading.temp)}°C`;
		place.textContent = `${reading.city}, ${reading.country}`;
		const sunset = formatSunset(reading.sunset);
		detail.textContent = [
			`Humidity ${Math.round(reading.humidity)}%`,
			sunset ? `Sunset ${sunset}` : null,
		]
			.filter(Boolean)
			.join(" · ");

		target.hidden = false;
	}

	function cached(): Reading | null {
		try {
			const raw = sessionStorage.getItem(CACHE_KEY);
			if (!raw) return null;
			const reading = JSON.parse(raw) as Reading;
			if (
				typeof reading?.temp !== "number" ||
				typeof reading?.humidity !== "number" ||
				Date.now() - reading.at > CACHE_MS
			) {
				return null;
			}
			return reading;
		} catch {
			return null;
		}
	}

	async function load(target: HTMLElement): Promise<void> {
		const city = target.dataset.city ?? "Ilorin";
		const country = target.dataset.country ?? "NG";
		const lat = target.dataset.lat ?? "8.4966";
		const lon = target.dataset.lon ?? "4.5426";

		const hit = cached();
		if (hit && hit.city === city) {
			paint(target, hit);
			return;
		}

		const url = new URL("https://api.open-meteo.com/v1/forecast");
		url.searchParams.set("latitude", lat);
		url.searchParams.set("longitude", lon);
		url.searchParams.set("current", "temperature_2m,relative_humidity_2m");
		url.searchParams.set("daily", "sunset");
		url.searchParams.set("forecast_days", "1");
		url.searchParams.set("timezone", "auto");

		try {
			const response = await fetch(url, { signal: AbortSignal.timeout(8000) });
			if (!response.ok) return;
			const data = (await response.json()) as {
				current?: { temperature_2m?: number; relative_humidity_2m?: number };
				daily?: { sunset?: string[] };
			};
			const temp = data.current?.temperature_2m;
			const humidity = data.current?.relative_humidity_2m;
			if (typeof temp !== "number" || typeof humidity !== "number") return;

			const reading: Reading = {
				temp,
				humidity,
				sunset: data.daily?.sunset?.[0] ?? null,
				city,
				country,
				at: Date.now(),
			};
			try {
				sessionStorage.setItem(CACHE_KEY, JSON.stringify(reading));
			} catch {
				// Private mode or a full quota: the reading still paints.
			}
			paint(target, reading);
		} catch {
			// Offline, blocked or slow: leave the line hidden.
		}
	}

	function start(): void {
		const targets = document.querySelectorAll<HTMLElement>("[data-weather]");
		for (const target of targets) void load(target);
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", start, { once: true });
	} else {
		start();
	}
</script>
