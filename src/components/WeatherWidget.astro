---
import Icon from "./Icon.astro";

const today = new Date().toLocaleDateString("en-GB", {
	weekday: "long",
	day: "numeric",
	month: "long",
	year: "numeric",
});
---

<div class="topbar__weather weather" data-weather data-weather-city="Lagos">
	<Icon name="sun" size={16} class="weather__icon" />
	<span class="weather__temp" data-weather-temp>31°C</span>
	<span class="weather__place"><span data-weather-city-label>Lagos</span>, NG</span>
	<span class="weather__detail" data-weather-detail>Humidity 30%</span>
	<span class="weather__date">{today}</span>
</div>