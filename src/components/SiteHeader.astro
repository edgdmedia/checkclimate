---
import type { MenuItem } from "emdash";
import logoLight from "../assets/brand/check-climate-lockup.png";
import logoDark from "../assets/brand/check-climate-lockup-reverse.png";
import CategoryNav from "./CategoryNav.astro";
import Icon from "./Icon.astro";
import ThemeToggle from "./ThemeToggle.astro";
import WeatherWidget from "./WeatherWidget.astro";
import { CLAIM_URL, SEARCH_URL, siteConfig } from "../utils/site";
import { formatDateline } from "../utils/locale";

interface Props {
	siteTitle: string;
	siteTagline: string;
	items: MenuItem[];
}

const { siteTitle, siteTagline, items } = Astro.props;
const { socials } = await siteConfig();
const today = new Date();
---

<header class="site-header">
	<div class="topbar">
		<div class="wrap topbar__inner">
			<div class="topbar__left">
				<time class="topbar__date" datetime={today.toISOString()}>
					{formatDateline(today)}
				</time>
				<WeatherWidget />
			</div>
			<div class="topbar__right">
				<ThemeToggle />
				<nav class="topbar__social" aria-label="Social">
					{socials.map((link) => (
						<a href={link.href} rel="noopener noreferrer">{link.label}</a>
					))}
				</nav>
			</div>
		</div>
	</div>

	<div class="masthead">
		<div class="wrap masthead__inner">
			<a href="/" class="masthead__brand" aria-label={`${siteTitle} home`}>
				<img
					class="masthead__logo masthead__logo--light"
					src={logoLight.src}
					width={logoLight.width}
					height={logoLight.height}
					alt="Check Climate"
				/>
				<img
					class="masthead__logo masthead__logo--dark"
					src={logoDark.src}
					width={logoDark.width}
					height={logoDark.height}
					alt="Check Climate"
				/>
				<span class="masthead__tagline">{siteTagline}</span>
			</a>

			<div class="masthead__actions">
				<form class="searchbox" action={SEARCH_URL} method="get" role="search">
					<label class="sr-only" for="site-search">Search stories and fact checks</label>
					<Icon name="search" size={18} class="searchbox__icon" />
					<input
						id="site-search"
						type="search"
						name="q"
						placeholder="Search stories and fact checks"
						autocomplete="off"
					/>
				</form>
				<a href={CLAIM_URL} class="btn btn--claim">
					<Icon name="check" size={18} />
					<span>Submit a claim</span>
				</a>
				<a href={SEARCH_URL} class="searchbox-link" aria-label="Search">
					<Icon name="search" size={22} />
				</a>
			</div>
		</div>

		<CategoryNav items={items} />
	</div>
</header>