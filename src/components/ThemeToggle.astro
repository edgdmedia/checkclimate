---
import Icon from "./Icon.astro";
---

<div class="theme-toggle" role="group" aria-label="Colour mode">
	<button type="button" class="theme-toggle__btn" data-set-theme="light">
		<Icon name="sun" size={14} />
		<span>Light</span>
	</button>
	<button type="button" class="theme-toggle__btn" data-set-theme="dark">
		<Icon name="moon" size={14} />
		<span>Dark</span>
	</button>
</div>

<script>
	function syncThemeButtons() {
		const theme = document.documentElement.getAttribute("data-theme") ?? "light";
		for (const button of document.querySelectorAll<HTMLButtonElement>(
			"[data-set-theme]",
		)) {
			button.setAttribute(
				"aria-pressed",
				button.dataset.setTheme === theme ? "true" : "false",
			);
		}
	}

	for (const button of document.querySelectorAll<HTMLButtonElement>(
		"[data-set-theme]",
	)) {
		button.addEventListener("click", () => {
			const theme = button.dataset.setTheme;
			if (theme !== "light" && theme !== "dark") return;
			document.documentElement.setAttribute("data-theme", theme);
			try {
				localStorage.setItem("theme", theme);
			} catch {
				// Storage can be blocked; the theme still applies for this page.
			}
			syncThemeButtons();
		});
	}

	syncThemeButtons();
</script>