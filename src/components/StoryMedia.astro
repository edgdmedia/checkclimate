---
/**
 * Story thumbnail. Media-library images have no `src`, so EmDash's `Image`
 * resolves the storage key. With no image the design uses a flat brand fill.
 * With MEDIA_PUBLIC_URL set, the image is resized at Cloudflare's edge on the
 * media domain (src/utils/media-url.ts) instead of by this process.
 */
import { Image } from "emdash/ui";
import { storyFill } from "../utils/site";
import { withEdgeSource } from "../utils/media-url";

interface Props {
	image?: unknown;
	seed: string;
	alt?: string;
	/** Credit line over the photo, as the design shows. */
	credit?: string | null;
	flag?: string | null;
	priority?: boolean;
	width?: number;
	height?: number;
	class?: string;
}

const {
	image,
	seed,
	alt = "",
	credit,
	flag,
	priority = false,
	width = 640,
	height = 427,
	class: className,
} = Astro.props;

const hasImage = Boolean(image);
const source = withEdgeSource(image, { width, height });
---

<div
	class:list={["story__media", className]}
	style={hasImage ? undefined : `background: ${storyFill(seed)}`}
>
	{
		hasImage && (
			<Image
				image={source as never}
				alt={alt}
				width={width}
				height={height}
				priority={priority}
				loading={priority ? "eager" : "lazy"}
				decoding="async"
			/>
		)
	}
	{flag && <span class="story__flag">{flag}</span>}
	{credit && <span class="story__credit">{credit}</span>}
</div>