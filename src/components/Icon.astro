---
/**
 * Inline stroke icons. No icon fonts, no emoji. Every icon is decorative and
 * hidden from assistive tech; the surrounding link or button carries the
 * accessible name.
 */
interface Props {
	name:
		| "search"
		| "check"
		| "arrow-right"
		| "arrow-left"
		| "arrow-up"
		| "facebook"
		| "x"
		| "linkedin"
		| "whatsapp"
		| "link"
		| "sun"
		| "moon"
		| "mail"
		| "upload"
		| "chevron-left"
		| "chevron-right"
		| "chevron-down"
		| "cloud"
		| "cloud-sun"
		| "cloud-moon"
		| "cloud-drizzle"
		| "cloud-rain"
		| "cloud-snow"
		| "cloud-lightning"
		| "cloud-fog"
		| "droplet"
		| "eye"
		| "sunrise"
		| "sunset"
		| "map-pin"
		| "clock"
		| "download";
	size?: number;
	class?: string;
}

