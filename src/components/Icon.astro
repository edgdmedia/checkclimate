---
/**
 * Inline stroke icons. No icon fonts, no emoji. Every icon is decorative and
 * hidden from assistive tech; the surrounding link or button carries the
 * accessible name.
 */
interface Props {
	name:
		| "search"
		| "check"
		| "arrow-right"
		| "arrow-left"
		| "arrow-up"
		| "facebook"
		| "x"
		| "linkedin"
		| "whatsapp"
		| "link"
		| "sun"
		| "moon"
		| "mail"
		| "upload"
		| "chevron-left"
		| "chevron-right"
		| "chevron-down";
	size?: number;
	class?: string;
}

const { name, size = 18, class: className } = Astro.props;
const paths: Record<Props["name"], string> = {
	search:
		'<circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>',
	check: '<path d="M5 12.5l4.5 4.5L19 7"></path>',
	"arrow-right": '<path d="M5 12h14"></path><path d="m13 5 7 7-7 7"></path>',
	"arrow-left": '<path d="M19 12H5"></path><path d="m11 19-7-7 7-7"></path>',
	"arrow-up": '<path d="M12 19V5"></path><path d="m5 12 7-7 7 7"></path>',
	facebook:
		'<path d="M15 3h-2.5A4.5 4.5 0 0 0 8 7.5V10H5v4h3v7h4v-7h3l1-4h-4V7.5c0-.8.7-1.5 1.5-1.5H16Z"></path>',
	x: '<path d="M4 4l16 16"></path><path d="M20 4 4 20"></path>',
	linkedin:
		'<path d="M6.5 9.5V19"></path><circle cx="6.5" cy="6" r="1.2"></circle><path d="M11 19v-9.5"></path><path d="M11 13.5c0-2 1.3-3.5 3.3-3.5 2 0 3.2 1.4 3.2 3.7V19"></path>',
	whatsapp:
		'<path d="M20 11.5a8 8 0 0 1-11.8 7L4 20l1.5-4.1A8 8 0 1 1 20 11.5Z"></path><path d="M8.5 9.5c0 3 2.5 5.5 5.5 5.5"></path>',
	link:
		'<path d="M10 14a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"></path><path d="M14 10a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"></path>',
	sun: '<circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>',
	moon: '<path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"></path>',
	mail: '<rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path>',
	upload:
		'<path d="M12 16V4"></path><path d="m7 9 5-5 5 5"></path><path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"></path>',
	"chevron-left": '<path d="m15 18-6-6 6-6"></path>',
	"chevron-right": '<path d="m9 18 6-6-6-6"></path>',
	"chevron-down": '<path d="m6 9 6 6 6-6"></path>',
};
---

<svg
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
	class={className}
	set:html={paths[name]}
/>