---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import {
	EmDashBodyStart,
	EmDashBodyEnd,
	EmDashHead,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { getSiteLocale } from "../utils/locale";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import BackToTop from "../components/BackToTop.astro";
import "../styles/global.css";
import "../styles/site.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
} = Astro.props;

const [settingsResult, primaryResult, footerResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
	getMenuWithCacheHint("footer"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(primaryResult.cacheHint);
	Astro.cache.set(footerResult.cacheHint);
}

const settings = settingsResult.data ?? {};
const siteTitle = settings.title ?? "Check Climate Africa";
const siteTagline =
	settings.tagline ?? "Disseminating Critical Climate Information";
const titleIncludesSite = title === siteTitle || title.endsWith(`— ${siteTitle}`);
const fullTitle = titleIncludesSite ? title : `${title} — ${siteTitle}`;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical: canonical ?? Astro.url.pathname,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

const lang = getSiteLocale() ?? "en";
---

<!doctype html>
<html lang={lang} data-theme="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={`${siteTitle} RSS Feed`}
			href="/feed/"
		/>
		<script is:inline>
			// Set the theme before paint. An explicit choice wins; otherwise follow
			// the operating system.
			(function () {
				try {
					var saved = localStorage.getItem("theme");
					var theme =
						saved === "light" || saved === "dark"
							? saved
							: window.matchMedia("(prefers-color-scheme: dark)").matches
								? "dark"
								: "light";
					document.documentElement.setAttribute("data-theme", theme);
				} catch (error) {
					document.documentElement.setAttribute("data-theme", "light");
				}
			})();
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a href="#main" class="skip-link">Skip to content</a>
		<SiteHeader
			siteTitle={siteTitle}
			siteTagline={siteTagline}
			items={primaryResult.data?.items ?? []}
		/>
		<main id="main" tabindex="-1">
			<slot />
		</main>
		<SiteFooter
			siteTitle={siteTitle}
			sections={primaryResult.data?.items ?? []}
			items={footerResult.data?.items ?? []}
		/>
		<BackToTop />
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>