# Public origin used for canonical URLs, sitemap, RSS and admin links.
EMDASH_SITE_URL=https://www.checkclimate.africa

# Neon Postgres — direct (non-pooled) connection strings.
# Prod branch: used by `emdash migrate` on deploy and by the content import.
NEON_DATABASE_URL=
# Dev branch: `wrangler dev` connects here through Hyperdrive's
# localConnectionString (see scripts/with-env.mjs and docs/RUNBOOK.md).
NEON_DEV_DATABASE_URL=

# Generated with `npx emdash secrets generate`. Never commit the real value.
EMDASH_ENCRYPTION_KEY=

# Resend transactional email (magic links, invites, claim notifications).
RESEND_API_KEY=
EMAIL_FROM=Check Climate Africa <newsroom@checkclimate.africa>

# Where claim submissions are sent.
CLAIMS_INBOX=CheckClimateAfrica@gmail.com

# Cloudflare Turnstile (claim form + comments).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=