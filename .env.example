# Public origin used for canonical URLs, sitemap, passkeys and CSRF.
EMDASH_SITE_URL=https://www.checkclimate.africa

# SQLite database and Astro session store. Keep both outside the deploy dir
# if you want a deploy to leave editors signed in.
DATABASE_PATH=./data/checkclimate.db
SESSION_DIR=./data/sessions

# Generated with `npx emdash secrets generate`. Never commit the real value.
EMDASH_ENCRYPTION_KEY=

# Cloudflare R2 (S3-compatible). Leave S3_BUCKET empty in local dev to use the
# local filesystem fallback.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PUBLIC_URL=

# Resend transactional email (magic links, invites, claim notifications).
RESEND_API_KEY=
EMAIL_FROM=Check Climate Africa <newsroom@checkclimate.africa>

# Where claim submissions are sent.
CLAIMS_INBOX=CheckClimateAfrica@gmail.com

# Cloudflare Turnstile (claim form + comments).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare cache purge (publish/unpublish and code deploys).
CF_ZONE_ID=
CF_PURGE_TOKEN=